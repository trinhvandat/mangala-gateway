# =============================================================================
# mangala-gateway - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
SERVER_PORT=8000

# -----------------------------------------------------------------------------
# Redis (Rate Limiting & Policy Cache)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for no password (local dev only)
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins.
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Downstream Service URLs
# Override these to point at real hosts in staging/prod.
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:8080
WALLET_SERVICE_URL=http://localhost:8081
PORTFOLIO_SERVICE_URL=http://localhost:8182
TRANSACTION_SERVICE_URL=http://localhost:8083
PRICE_FEED_SERVICE_URL=http://localhost:8084
CRAWLER_SERVICE_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:8086
TRANSACTION_HISTORY_SERVICE_URL=http://localhost:8087

# -----------------------------------------------------------------------------
# JWT  (SECRET)
# Must be a Base64-encoded 256-bit (32-byte) random value in production.
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
JWT_SECRET=your-256-bit-secret-key-for-jwt-signing-replace-in-production
JWT_ISSUER=mangala
# Milliseconds
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Requests per second allowed to pass through
RATE_LIMIT_REPLENISH=10
# Maximum burst size
RATE_LIMIT_BURST=20

# -----------------------------------------------------------------------------
# Security Headers
# Disable for local dev; enable for staging and production.
# -----------------------------------------------------------------------------
SECURITY_HEADERS_ENABLED=false
SECURITY_HSTS_ENABLED=false
# Example: default-src 'self'
SECURITY_CSP=
# Example: strict-origin-when-cross-origin
SECURITY_REFERRER_POLICY=
# Example: camera=(), microphone=()
SECURITY_PERMISSIONS_POLICY=

# -----------------------------------------------------------------------------
# Policy Cache (fetched from Auth Service)
# -----------------------------------------------------------------------------
POLICY_LOAD_TIMEOUT=30
POLICY_VERSION_CHECK_INITIAL_DELAY=15
POLICY_VERSION_CHECK_INTERVAL=60
POLICY_FAIL_ON_LOAD_ERROR=true
POLICY_REDIS_CHANNEL=policy:updates
POLICY_USE_KAFKA=false
POLICY_HEALTH_CHECK=true
# ALLOW | DENY
POLICY_NO_MATCH_BEHAVIOR=DENY
POLICY_DEV_PROFILES=dev,local,test
# Set to true to enforce mTLS for policy fetching in non-dev profiles
POLICY_MTLS_ENFORCE_NON_DEV=true

# mTLS key/trust store (required when POLICY_MTLS_ENABLED=true)
POLICY_MTLS_ENABLED=false
POLICY_MTLS_KEY_STORE_PATH=
POLICY_MTLS_KEY_STORE_PASSWORD=
POLICY_MTLS_KEY_STORE_TYPE=PKCS12
POLICY_MTLS_TRUST_STORE_PATH=
POLICY_MTLS_TRUST_STORE_PASSWORD=
POLICY_MTLS_TRUST_STORE_TYPE=PKCS12

# -----------------------------------------------------------------------------
# ABAC / SpEL Evaluation
# -----------------------------------------------------------------------------
ABAC_SPEL_ENABLED=true
ABAC_MAX_EXPR_LENGTH=500
ABAC_EVAL_TIMEOUT=100
ABAC_CACHE_SIZE=1000

# -----------------------------------------------------------------------------
# Audit Logging (Kafka)
# -----------------------------------------------------------------------------
AUDIT_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AUDIT_BATCH_SIZE=16384
AUDIT_LINGER_MS=10
AUDIT_BUFFER_MEMORY=33554432
AUDIT_MAX_BLOCK_MS=100
AUDIT_ALLOWED=true
AUDIT_DENIED=true
AUDIT_NO_POLICY=true
